<div class="toastMsg" id="cancelledChanges_fulfillment">
                            <div class="toast-body cancelChanges_Toast">
                                <div class="toast_bluecaution"></div>
                                <p class="toastMsg-cancelChanges">Fulfillment request cancelled successfully.
                                </p>
                                <div class="blueclose_toast"></div>
                            </div>
                        </div>
                        
                        <div class="toastMsg" id="fail_toastmsg_fulfillment">
                            <div class="toast-body ">
                                <div class="toast_cautionIcon"></div>
                                <div class="cautionMsg">
                                <p class="toastMsg-error">Fulfillment cancel request failed.</p>
                                </div>
                                 <div class="blueclose_toast"></div>
                            </div>
                        </div>
                        <div class="toastMsg" id="success_toastmsg_fulfillment">
                            <div class="toast-body successToast">
                                <div class="toast_successIcon"></div>
                                <p class="toastMsg-success">Fulfillment request added successfully.</p>
                                <div class="success_close"></div>
                            </div>
                        </div>




document.querySelectorAll('.blueclose_toast, .success_close').forEach(function (btn) {
  btn.addEventListener('click', function () {
    this.closest('.toastMsg').style.display = 'none';
  });
});
 
<div class="blueclose_toast"></div>, <div class="success_close"></div>
 
