<div class="drawer-footer">
		<div class="form_footer btn-container">
			<button class="btn btn-primary save_btn_fulfillment"
				data-toggle="modal" data-target="" >Save</button>
			<button class="btn btn-default" data-toggle="modal"
				data-target="#cancel_popup_add_opportunity">Cancel</button>
		</div>
	</div>


<div class="modal popup-confirmation-msg" tabindex="-1" role="dialog"
			id="cancel_popup_add_opportunity" aria-hidden="true">
			<div class="popup-bg"></div>
			<div class="modal-dialog modal-dialog-centered" role="document">
				<div class="modal-content">
					<div class="modal-header popup-header">
						<h2>Cancel Request</h2>
						<span class="close-popup" data-dismiss="modal"></span>
					</div>
					<div class="modal-body popup-body">
						<p>Are you sure you want to cancel? You will lose all unsaved
							changes</p>
					</div>
					<div class="modal-footer popup-footer">
						<button class="btn btn-default yesBtn"
							id="cancelChanges_fulfillment" data-dismiss="modal">Yes</button>
						<button class="btn btn-primary noBtn" data-dismiss="modal">No</button>
					</div>
				</div>
			</div>
		</div>


$(document).ready(function () {
  $('#cancel_popup_add_opportunity').modal({
    backdrop: 'static',  // prevents closing when clicking outside
    keyboard: false      // prevents closing on ESC key
  });
});
