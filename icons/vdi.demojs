function showToast(message, type = "success") {
  const toast = document.getElementById("globalToast");
  const text = document.getElementById("toastText");
  const body = document.getElementById("toastBody");

  text.innerText = message;

  // reset styles
  body.classList.remove("toast-error");

  if (type === "error") {
    body.classList.add("toast-error");
  }

  toast.style.display = "block";

  // auto hide after 3 sec
  setTimeout(() => {
    toast.style.display = "none";
  }, 3000);
}

// close manually
document.getElementById("toastClose").onclick = function () {
  document.getElementById("globalToast").style.display = "none";
};
// Save button
document.getElementById("saveBtn").addEventListener("click", function () {
  showToast("Fulfillment request added successfully.", "success");
});

// Cancel button
document.getElementById("cancelBtn").addEventListener("click", function () {
  showToast("Fulfillment request cancelled successfully.", "success");
});

// Error example
showToast("Fulfillment cancel request failed.", "error");
