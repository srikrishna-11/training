const FulfillmentForm = (function () {

  let selectedValues = [];
  const maxSelections = 3;

  /* =========================
     CONFIG
  ========================== */
  const selectors = {
    form: '#fulfillment_content',
    saveBtn: '.save_btn_fulfillment',
    inputs: 'input.mandatory_editableFields',
    selects: 'select.mandatory_editableFields',
    dropdownBtn: '#dropdownButton',
    dropdownItems: '.dropdown-item',
    dropdownError: '#fulfillment_mandatoryText'
  };

  /* =========================
     VALIDATION FUNCTIONS
  ========================== */

  function validateInput($el) {
    const isValid = $el.val().trim() !== "";
    toggleError($el, isValid);
    return isValid;
  }

  function validateSelect($el) {
    const val = $el.val();
    const isValid = val && val !== "Select";
    toggleError($el, isValid);
    return isValid;
  }

  function validateDropdown() {
    const isValid = selectedValues.length > 0;

    if (isValid) {
      $(selectors.dropdownBtn).removeClass('warningBorder');
      $(selectors.dropdownError).hide();
    } else {
      $(selectors.dropdownBtn).addClass('warningBorder');
      $(selectors.dropdownError).show();
    }

    return isValid;
  }

  function toggleError($el, isValid) {
    const $error = $el.siblings('.warning_text');

    if (isValid) {
      $el.removeClass('warningBorder');
      $error.hide();
    } else {
      $el.addClass('warningBorder');
      $error.show();
    }
  }

  /* =========================
     MAIN VALIDATION
  ========================== */
  function validateForm() {
    let isValid = true;

    $(selectors.inputs).each(function () {
      if (!validateInput($(this))) isValid = false;
    });

    $(selectors.selects).each(function () {
      if (!validateSelect($(this))) isValid = false;
    });

    if (!validateDropdown()) isValid = false;

    return isValid;
  }

  /* =========================
     DROPDOWN LOGIC
  ========================== */
  function renderDropdown() {
    const $container = $(selectors.dropdownBtn).find('.selected-container');

    if (selectedValues.length > 0) {
      $container.html(selectedValues.map(v => `
        <span class="selected-item">
          ${v} <span class="remove-icon" data-value="${v}">X</span>
        </span>
      `).join(""));

      validateDropdown(); // remove error when valid

    } else {
      $container.text("Select");
    }
  }

  function bindDropdownEvents() {
    $(document).on('click', selectors.dropdownItems, function (e) {
      e.preventDefault();
      const value = $(this).data('value');

      if (!selectedValues.includes(value)) {
        if (selectedValues.length < maxSelections) {
          selectedValues.push(value);
        }
      } else {
        selectedValues = selectedValues.filter(v => v !== value);
      }

      renderDropdown();
    });

    $(document).on('click', '.remove-icon', function (e) {
      e.stopPropagation();
      const value = $(this).data('value');
      selectedValues = selectedValues.filter(v => v !== value);
      renderDropdown();
    });
  }

  /* =========================
     EVENT BINDINGS
  ========================== */
  function bindEvents() {

    // Save button
    $(selectors.saveBtn).on('click', function (e) {
      if (!validateForm()) {
        e.preventDefault();
      }
    });

    // Live validation (INPUT)
    $(document).on('input', selectors.inputs, function () {
      validateInput($(this));
    });

    // Live validation (SELECT)
    $(document).on('change', selectors.selects, function () {
      validateSelect($(this));
    });
  }

  /* =========================
     INIT
  ========================== */
  function init() {
    bindEvents();
    bindDropdownEvents();
  }

  return {
    init
  };

})();


/* =========================
   INITIALIZE
========================= */
$(document).ready(function () {
  FulfillmentForm.init();
});
